FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN pip install --upgrade pip && pip install --index-url https://download.pytorch.org/whl/cpu torch==2.3.1
COPY runner/agent.py /opt/kf/agent.py

CMD ["python", "-c", "import torch; print(torch.__version__)"]
